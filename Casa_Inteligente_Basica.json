    {
        "id": "verificar_luces_v2",
        "type": "function",
        "z": "tab_casa_domotica_v2",
        "name": "Verificar luces",
        "func": "flow.set(msg.topic, msg.payload);\n\nlet habitacion = flow.get(\"habitacion\") || false;\nlet sala = flow.get(\"sala\") || false;\nlet cocina = flow.get(\"cocina\") || false;\nlet bano = flow.get(\"bano\") || false;\n\nmsg.payload = habitacion && sala && cocina && bano;\nmsg.topic = \"general\";\nmsg.from = \"verify\";\n\nreturn msg;",
        "outputs": 1,
        "x": 860,
        "y": 480,
        "wires": [
            [
                "luz_general_v2"
            ]
        ]
    },
    {
        "id": "calcular_consumo_v2",
        "type": "function",
        "z": "tab_casa_domotica_v2",
        "name": "Calcular consumo",
        "func": "let consumo = 200; // consumo base\n\nif (flow.get(\"habitacion\")) consumo += 100;\nif (flow.get(\"sala\")) consumo += 150;\nif (flow.get(\"cocina\")) consumo += 200;\nif (flow.get(\"bano\")) consumo += 80;\n\nmsg.payload = consumo;\nreturn msg;",
        "outputs": 1,
        "timeout": "",
