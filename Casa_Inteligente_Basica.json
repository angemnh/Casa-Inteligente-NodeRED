    {
        "id": "inject_temp_v2",
        "type": "inject",
        "z": "tab_casa_domotica_v2",
        "name": "Generar temperatura",
        "props": [
            {
                "p": "payload"
            }
        ],
        "repeat": "5",
        "once": true,
        "onceDelay": "1",
