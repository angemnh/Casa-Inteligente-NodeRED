    {
        "id": "control_general_v2",
        "type": "function",
        "z": "tab_casa_domotica_v2",
        "name": "Control General",
        "func": "if (msg.from === \"verify\") {\n    return [null, null, null, null];\n}\n\nlet estado = msg.payload;\n\nflow.set(\"habitacion\", estado);\nflow.set(\"sala\", estado);\nflow.set(\"cocina\", estado);\nflow.set(\"bano\", estado);\n\nreturn [\n    { payload: estado, topic: \"habitacion\", from: \"general\" },\n    { payload: estado, topic: \"sala\", from: \"general\" },\n    { payload: estado, topic: \"cocina\", from: \"general\" },\n    { payload: estado, topic: \"bano\", from: \"general\" }\n];",
        "outputs": 4,
        "x": 420,
        "y": 380,
        "wires": [
            [
                "sw_habitacion_v2"
            ],
            [
                "sw_sala_v2"
            ],
            [
                "sw_cocina_v2"
            ],
            [
                "sw_bano_v2"
            ]
        ]
    },
