        "format": "<div style=\"display:grid;grid-template-columns:repeat(3,1fr);gap:18px;font-family:'Segoe UI',Arial;\">\n<div style=\"background:rgb(15,23,42);color:white;border:1px solid rgb(51,65,85);border-radius:18px;padding:22px;box-shadow:0 8px 20px rgba(0,0,0,.25);\"><div style=\"font-size:34px;\">🌡️</div><div style=\"font-size:20px;font-weight:800;margin-top:8px;\">Monitoreo Ambiental</div><div style=\"font-size:13px;margin-top:6px;color:rgb(203,213,225);\">Temperatura del hogar en tiempo real.</div></div>\n<div style=\"background:rgb(15,23,42);color:white;border:1px solid rgb(51,65,85);border-radius:18px;padding:22px;box-shadow:0 8px 20px rgba(0,0,0,.25);\"><div style=\"font-size:34px;\">💡</div><div style=\"font-size:20px;font-weight:800;margin-top:8px;\">Iluminación Inteligente</div><div style=\"font-size:13px;margin-top:6px;color:rgb(203,213,225);\">Control de luces por área de la vivienda.</div></div>\n<div style=\"background:rgb(15,23,42);color:white;border:1px solid rgb(51,65,85);border-radius:18px;padding:22px;box-shadow:0 8px 20px rgba(0,0,0,.25);\"><div style=\"font-size:34px;\">⚡</div><div style=\"font-size:20px;font-weight:800;margin-top:8px;\">Gestión Energética</div><div style=\"font-size:13px;margin-top:6px;color:rgb(203,213,225);\">Consumo calculado según luces encendidas.</div></div>\n</div>",
        "templateScope": "local",
        "x": 130,
        "y": 100,
        "wires": [
            []
        ]
