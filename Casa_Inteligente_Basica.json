    {
        "id": "function_temp_v2",
        "type": "function",
        "z": "tab_casa_domotica_v2",
        "name": "Temperatura aleatoria",
        "func": "let temperatura = Math.floor(Math.random() * (35 - 18 + 1)) + 18;\nmsg.payload = temperatura;\nreturn msg;",
        "outputs": 1,
        "x": 410,
        "y": 180,
        "wires": [
            [
                "gauge_temp_v2",
                "estado_temp_v2",
                "debug_temp_v2"
