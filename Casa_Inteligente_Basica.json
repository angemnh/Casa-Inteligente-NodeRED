    {
        "id": "estado_temp_v2",
        "type": "function",
        "z": "tab_casa_domotica_v2",
        "name": "Estado temperatura",
        "func": "let t = msg.payload;\nif (t < 20) {\n    msg.payload = \"❄️ Temperatura baja: \" + t + \" °C\";\n} else if (t <= 28) {\n    msg.payload = \"✅ Temperatura normal: \" + t + \" °C\";\n} else {\n    msg.payload = \"🔥 Temperatura alta: \" + t + \" °C\";\n}\nreturn msg;",
        "outputs": 1,
        "x": 670,
        "y": 190,
        "wires": [
            [
                "text_temp_v2"
            ]
        ]
    },
